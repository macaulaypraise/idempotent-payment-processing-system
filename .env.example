# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (POSTGRES_* are read by the postgres container in docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments_db
# Migrations run as the owner...
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/payments_db
# ...the app runs as a restricted role that cannot UPDATE/DELETE ledger rows.
# The migrate service creates the role and sets this password on it.
APP_DB_ROLE=ipps_app
APP_DB_PASSWORD=ipps_app_local_only
DATABASE_URL=postgresql+asyncpg://ipps_app:ipps_app_local_only@postgres:5432/payments_db
DB_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka (KRaft). Containers use the INTERNAL listener kafka:29092;
# processes on the host use localhost:9092.
# Topics (fixed in code, ADR 0005): payments.v1 (every payment.* and refund.*
# event, keyed by payment id), dlq.v1, ledger.v1 (reserved).
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TIMEOUT_MS=2000

# Payment provider (PSP simulator) and the charger/sweeper
PSP_BASE_URL=http://psp-sim:8001
PSP_TIMEOUT_SECONDS=3
PSP_LEASE_SECONDS=30
PSP_MAX_ATTEMPTS=6
PSP_RETRY_BASE_SECONDS=2
SWEEPER_INTERVAL_SECONDS=5
# Crash points, e.g. FAILPOINTS=charger.after_provider_call=exit (never in production)
FAILPOINTS=

# Provider webhooks. docker-compose passes this to both the API and the PSP
# simulator; change it in both places outside compose. Empty rejects all.
PSP_WEBHOOK_SECRET=local-dev-webhook-secret
PSP_WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=10

# Outbox relay: woken by NOTIFY; the fallback poll also bounds failover time
OUTBOX_BATCH_SIZE=100
OUTBOX_FALLBACK_POLL_SECONDS=5

# Observability
LOG_LEVEL=INFO
SERVICE_NAME=ipps-payment-api
METRICS_PATH=/metrics

# Grafana (local only; docker-compose reads GF_ADMIN_PASSWORD)
GF_ADMIN_PASSWORD=admin
